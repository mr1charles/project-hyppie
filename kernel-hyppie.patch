index 1d64224a4..b1b8f1110 100644
--- a/drivers/samsung/sec_reboot.c
+++ b/drivers/samsung/sec_reboot.c
@@ -321,6 +321,74 @@ static void sec_power_off(void)
 	}
 }
 
+
+/*
+ * Project Hyppie fail-safe: a failed boot must always end up in recovery (TWRP), never stuck.
+ *  - reboots requested because something failed ("*-failed", panic) are redirected to recovery
+ *  - a timer reboots to recovery unless userspace reports boot completion in time
+ *    (echo 1 > /sys/module/sec_reboot/parameters/hyppie_boot_done)
+ */
+#include <linux/moduleparam.h>
+#include <linux/workqueue.h>
+#include <linux/sched/signal.h>
+#include <linux/rcupdate.h>
+#include <linux/reboot.h>
+
+static bool hyppie_boot_done;
+static unsigned int hyppie_boot_timeout = 25 * 60;   /* seconds */
+module_param(hyppie_boot_done, bool, 0644);
+module_param(hyppie_boot_timeout, uint, 0644);
+
+static bool hyppie_failed_cmd(const char *cmd)
+{
+	size_t n;
+
+	if (oops_in_progress)
+		return true;
+	if (!cmd)
+		return false;
+	n = strlen(cmd);
+	return !strncmp(cmd, "panic", 5) || strstr(cmd, "failed") ||
+	       (n >= 7 && !strcmp(cmd + n - 7, "-failed"));
+}
+
+static bool hyppie_userspace_up(void)
+{
+	struct task_struct *p;
+	bool up = false;
+
+	rcu_read_lock();
+	for_each_process(p) {
+		if (!strcmp(p->comm, "system_server")) {
+			up = true;
+			break;
+		}
+	}
+	rcu_read_unlock();
+	return up;
+}
+
+static void hyppie_boot_timer_fn(struct work_struct *work)
+{
+	if (hyppie_boot_done)
+		return;
+	/* Android's main system is running: the userspace boot guard owns late-stage failures */
+	if (hyppie_userspace_up()) {
+		pr_info("hyppie: system_server is up, kernel boot timer stands down\n");
+		return;
+	}
+	pr_emerg("hyppie: boot not completed after %us, rebooting to recovery\n", hyppie_boot_timeout);
+	kernel_restart("recovery");
+}
+static DECLARE_DELAYED_WORK(hyppie_boot_timer, hyppie_boot_timer_fn);
+
+static int __init hyppie_boot_timer_init(void)
+{
+	schedule_delayed_work(&hyppie_boot_timer, hyppie_boot_timeout * HZ);
+	return 0;
+}
+late_initcall(hyppie_boot_timer_init);
+
