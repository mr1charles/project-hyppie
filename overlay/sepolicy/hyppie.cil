; Project Hyppie: boot guard runs in its own permissive domain (logs denials, never blocks)
(type hyppie_guard)
(roletype object_r hyppie_guard)
(type hyppie_guard_exec)
(roletype object_r hyppie_guard_exec)
(typeattributeset domain (hyppie_guard))
(typeattributeset file_type (hyppie_guard_exec))
(typeattributeset exec_type (hyppie_guard_exec))
(typeattributeset vendor_file_type (hyppie_guard_exec))
(typepermissive hyppie_guard)
(allow init_202504 hyppie_guard_exec (file (read getattr map execute open)))
(allow init_202504 vendor_shell_exec_202504 (file (read getattr map execute open)))
(allow init_202504 hyppie_guard (process (transition siginh rlimitinh)))
(dontaudit init_202504 hyppie_guard (process (noatsecure)))
(allow hyppie_guard hyppie_guard_exec (file (read getattr map execute open entrypoint)))
(allow hyppie_guard vendor_shell_exec_202504 (file (read getattr map execute open entrypoint)))
; the guard polls the process list (pidof) and system properties: don't flood the log with those reads
(dontaudit hyppie_guard domain (dir (search getattr read open)))
(dontaudit hyppie_guard domain (file (read open getattr)))
(dontaudit hyppie_guard domain (lnk_file (read getattr)))
(dontaudit hyppie_guard property_type (file (read open getattr map)))
